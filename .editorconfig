# Que todos los editores guarden igual, sin depender de la configuración de cada
# máquina. La extensión EditorConfig de VS Code lo aplica sola.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
