# ============================================================================
# .env  —  CONFIGURACION DEL FRONT (Vite)
# ----------------------------------------------------------------------------
# Solo las variables que empiezan con VITE_ llegan al navegador. OJO: lo que se
# ponga aca queda VISIBLE para cualquiera que abra la aplicacion, asi que no
# van credenciales. Las de la base estan en backend/.env, que no se sube a git.
# ============================================================================

# Donde escucha la API. En desarrollo, el backend corre en el puerto 3000.
# Cuando se despliegue en el servidor del area, se cambia por su direccion.
#
# OJO: va la IP de la PC y no "localhost" para que TAMBIEN funcione desde un
# celular de la misma red (en el celular, localhost es el celular). Si la IP
# de la PC cambia (ipconfig), hay que actualizar esta linea y la de
# ORIGEN_FRONT en backend/.env.
VITE_API_URL=http://172.16.11.98:3000
