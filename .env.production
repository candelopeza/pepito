# ============================================================================
# .env.production  —  LO QUE USA `npm run build` (la version que va al servidor)
# ----------------------------------------------------------------------------
# Vite lee este archivo solo al compilar; `npm run dev` sigue usando .env.
# Asi el .env de desarrollo queda vacio para todos y la compilacion sale lista
# para produccion sin tocar nada a mano.
#
# Como esta armado el servidor (Sistemas, 2026-11-06): Apache sirve el
# dist/index.html en https://grangenerador.smt.gob.ar (puerto 443) y el
# backend escucha aparte, con su propio HTTPS, en el puerto 3344. Por eso la
# API NO esta en "/" sino en el mismo dominio con el puerto 3344.
# (Si algun dia el backend sirve tambien el front con CARPETA_FRONT=../dist,
#  esto vuelve a ser "/".)
# ============================================================================
VITE_API_URL= https://estadisticas.smt.gob.ar:3344/
#VITE_API_URL= http://localhost:3344
