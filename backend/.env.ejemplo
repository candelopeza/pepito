# Copiar este archivo como ".env" (sin ".ejemplo") y completar con los datos
# de la base que se ve en HeidiSQL. El .env NO se sube a git.

# Puerto donde escucha la API (en desarrollo 3000; en el servidor de producción
# 181.105.6.205 es el 3344, el que Sistemas dejó abierto para el sistema)
PUERTO=3000

# Origen permitido para el front (Vite). Dejar vacío para permitir cualquiera en desarrollo
# (la PC en localhost:5174 y los celulares de la red local con la IP de la PC).
ORIGEN_FRONT=

# Conexión a MariaDB (los mismos datos que se cargan en HeidiSQL al conectar)
DB_HOST=
DB_PUERTO=
DB_USUARIO=
DB_CLAVE=
DB_NOMBRE=grandes_generadores

# --- Opcionales (agregados el 2026-10-01) -----------------------------------
# Zona horaria: los plazos se calculan con el "hoy" de esta máquina.
TZ=America/Argentina/Tucuman

# Geocodificador. Vacío = no se inventan coordenadas: el local queda para revisar
# en Herramientas > Geocodificación. "simulado" solo para una base de PRUEBA.
GEOCODIFICADOR=

# Rol declarado por el navegador para nombres que no están en la tabla usuario.
# Apagado (no) desde el 2026-11-06: solo entran los usuarios cargados en la
# base. "si" ÚNICAMENTE para correr las pruebas automáticas (pruebas/*.mjs)
# contra un backend de prueba. Nunca en producción.
ACEPTAR_ROL_DECLARADO=no

# "Editar observaciones" en la ficha. Con si, solo se puede si la base tiene
# el historial (sql/05), para que quede qué decían antes. Con no (o sin la
# línea), se puede siempre; sin el historial, lo anterior no queda guardado.
EXIGIR_HISTORIAL_OBSERVACIONES=no

# Carpeta de las fotos de las entregas (tabla opcional archivo, sql/08).
# Vacío = backend/archivos. Tiene que entrar en el respaldo del servidor.
CARPETA_ARCHIVOS=

# La aplicación servida por este mismo backend (agregado el 2026-10-15).
# Vacío = no (la app se sirve aparte, como en desarrollo con npm run dev).
# Con la carpeta del build (../dist) el backend entrega la app en "/" y la API
# en la misma dirección: así una sola dirección HTTPS alcanza para los teléfonos.
# El front se compila con VITE_API_URL=/ (ver backend/PROCEDIMIENTO.md, sección 16).
CARPETA_FRONT=

# Comprimir lo que manda el backend (agregado el 2026-10-21). Vacío o "si":
# comprime (los datos bajan ~10 veces: clave en el teléfono con poca señal).
# "no" solo si el servidor de Sistemas ya comprime por su cuenta.
COMPRIMIR=

# --- CiDiTuc: el inicio de sesión único (agregado el 2026-11-12) --------------
# CiDiTuc abre el sistema con un token y el backend lo verifica para saber quién
# es la persona (backend/cidituc.js). Se configura UNA de estas tres formas,
# según lo que indique Sistemas. Sin ninguna, nadie se identifica (todos entran
# como público) y GET /salud muestra cidituc: "apagado".
#   1) JWT firmado con secreto compartido (HS256). Es el caso de CiDiTuc: el token
#      llega en el parámetro "auth" de la URL y el secreto es el mismo que usan
#      estadísticas y reclamos (preguntar a Sistemas; no se escribe acá):
CIDITUC_SECRETO=
#   2) JWT firmado por CiDiTuc (RS256/ES256), se verifica con su clave pública.
#      El PEM entero en una línea, con \n donde van los saltos:
CIDITUC_CLAVE_PUBLICA=
#   3) Se le pregunta a CiDiTuc por la persona (GET con el mismo Bearer; con
#      CIDITUC_URL_METODO=POST manda { token } en el body):
CIDITUC_URL_VALIDAR=
CIDITUC_URL_METODO=
# Nombres de los campos dentro del token o de la respuesta (admiten ruta con
# puntos, ej. usuario.id_persona). Vacío = id_persona / cuil / nombre.
CIDITUC_CAMPO_PERSONA=
CIDITUC_CAMPO_CUIL=
CIDITUC_CAMPO_NOMBRE=
